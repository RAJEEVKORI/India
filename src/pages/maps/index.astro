---
import { getCollection } from 'astro:content';
import '../../styles/tiranga-theme.css';

const maps = (await getCollection('maps')).sort((a, b) => a.slug.localeCompare(b.slug));
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rajeevkori.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "name": "Verified Survey of India Map Download Hub",
  "description": "Legally compliant SVG, 4K PNG, and transparent WebP maps of India based on Survey of India cartographic baselines.",
  "url": `${siteUrl}${base}/maps/`,
  "dataset": maps.map((map) => ({
    "@type": "Dataset",
    "name": map.data.title,
    "identifier": map.data.mapCode,
    "description": `Official ${map.data.scale} scale map of India (${map.data.projection}). Verified against ${map.data.authority}.`,
    "license": map.data.authorityUrl,
    "keywords": map.data.seoKeywords,
    "isBasedOn": map.data.authorityUrl,
    "distribution": [
      { "@type": "DataDownload", "encodingFormat": "image/svg+xml", "contentUrl": `${siteUrl}${base}${map.data.files.svg}` },
      { "@type": "DataDownload", "encodingFormat": "image/png", "contentUrl": `${siteUrl}${base}${map.data.files.png4k}` },
      { "@type": "DataDownload", "encodingFormat": "image/webp", "contentUrl": `${siteUrl}${base}${map.data.files.webpTransparent}` },
      ...(map.data.files.pdf ? [{ "@type": "DataDownload", "encodingFormat": "application/pdf", "contentUrl": `${siteUrl}${base}${map.data.files.pdf}` }] : [])
    ]
  }))
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Official Map of India Download Hub (SVG, 4K PNG, WebP) | Survey of India Baseline</title>
  <meta name="description" content="Download verified, legally compliant maps of India (28 States, 8 UTs, 15,106.7 km land border) in SVG, 4K PNG, and transparent WebP formats." />
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
  <style>
    .map-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-top: 4px solid var(--chakra-blue);
      border-radius: var(--radius-lg);
      padding: clamp(1.75rem, 3.5vw, 2.75rem);
      margin-bottom: 2.5rem;
      box-shadow: var(--shadow-calm);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .map-card:nth-child(3n+1) { border-top-color: var(--saffron-flag); }
    .map-card:nth-child(3n+2) { border-top-color: var(--chakra-blue); }
    .map-card:nth-child(3n+3) { border-top-color: var(--green-accent); }
    .map-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-hover);
    }
    .download-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: 1.5rem;
    }
    .btn-dl {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7rem 1.35rem;
      border-radius: var(--radius-pill);
      font-weight: 600;
      font-size: 0.9rem;
      text-decoration: none;
      border: 1px solid var(--chakra-border);
      background: var(--chakra-faint);
      color: var(--chakra-blue);
      transition: all 0.2s ease;
    }
    .btn-dl.primary {
      background: var(--chakra-blue);
      color: #FFFFFF;
      border-color: var(--chakra-blue);
    }
    .btn-dl.pdf {
      background: var(--green-accent);
      color: #FFFFFF;
      border-color: var(--green-accent);
    }
    .btn-dl:hover {
      background: var(--saffron-flag);
      color: #FFFFFF;
      border-color: var(--saffron-flag);
      transform: translateY(-2px);
    }
    .embed-box {
      margin-top: 1.5rem;
      background: var(--bg-canvas);
      padding: 1rem 1.25rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-subtle);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--ink-body);
      overflow-x: auto;
    }
  </style>
</head>
<body>
  <div class="container animate-fade-up">
    <a href={`${base || '/'}`} class="back-link">← Back to Master Repository Hub</a>
    
    <header class="hero-header">
      <span class="badge-tiranga">✓ Survey of India 1:4M Baseline Compliant</span>
      <h1>Official Map of India — Creator & Media Download Hub</h1>
      <p style="color: var(--ink-muted); max-width: 840px; font-size: 1.08rem;">
        Verified, distortion-free vector and raster maps of the Republic of India depicting the complete 15,106.7 km international land boundary and 7,516.6 km coastline across all 28 States and 8 Union Territories.
      </p>
    </header>

    <main>
      {await Promise.all(maps.map(async (map) => {
        const { Content } = await map.render();
        const embedString = `<img src="${siteUrl}${base}${map.data.files.webpTransparent}" alt="${map.data.title} - Survey of India Baseline" />`;
        return (
          <article class="map-card" id={map.data.mapCode}>
            <span class="badge-saffron">{map.data.mapCode}</span>
            <h2 style="margin-top: 0.25rem;">{map.data.title}</h2>
            
            <div class="table-container">
              <table>
                <tbody>
                  <tr><td><strong>Official Scale & Projection</strong></td><td>{map.data.scale} ({map.data.projection})</td></tr>
                  <tr><td><strong>Statutory Authority</strong></td><td><a href={map.data.authorityUrl} target="_blank" rel="noopener">{map.data.authority}</a></td></tr>
                  <tr><td><strong>Supported Aspect Ratios</strong></td><td>{map.data.aspectRatios.join('  •  ')}</td></tr>
                  <tr><td><strong>SHA-256 Integrity Hash</strong></td><td><code>{map.data.sha256}</code></td></tr>
                </tbody>
              </table>
            </div>

            {map.data.previewImage && (
              <div style="text-align: center; margin: 1.5rem 0; background: var(--bg-canvas); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); overflow: hidden; padding: 1rem;">
                <img src={`${base}${map.data.previewImage}`} alt={map.data.title} style="max-width: 100%; height: auto; max-height: 480px; display: inline-block; vertical-align: middle; border-radius: 8px; box-shadow: var(--shadow-calm);" loading="lazy" />
              </div>
            )}

            <Content/>

            <div class="download-group">
              {map.data.files.pdf && <a href={`${base}${map.data.files.pdf}`} download class="btn-dl pdf">⬇ Official Vector (.PDF)</a>}
              <a href={`${base}${map.data.files.svg}`} download class="btn-dl primary">⬇ Vector Master (.SVG)</a>
              <a href={`${base}${map.data.files.png4k}`} download class="btn-dl">⬇ 4K Ultra-HD (.PNG)</a>
              <a href={`${base}${map.data.files.webpTransparent}`} download class="btn-dl">⬇ Transparent Overlay (.WebP)</a>
            </div>

            <div class="embed-box">
              <strong style="color: var(--chakra-blue); display: block; margin-bottom: 0.35rem;">Direct HTML Embed & Attribution Code:</strong>
              {embedString}
            </div>
          </article>
        );
      }))}
    </main>
  </div>
</body>
</html>
