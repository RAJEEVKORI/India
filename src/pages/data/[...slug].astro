---
import { getCollection } from 'astro:content';
import '../../styles/tiranga-theme.css';

export async function getStaticPaths() {
  const dataEntries = await getCollection('data');
  return dataEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rajeevkori.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = `${siteUrl}${base}/data/${entry.slug}/`;

const schemaMarkup = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": pageUrl,
      "url": pageUrl,
      "name": entry.data.title,
      "datePublished": entry.data.lastUpdated.toISOString(),
      "dateModified": entry.data.lastUpdated.toISOString()
    },
    {
      "@type": "Dataset",
      "@id": `${pageUrl}#dataset`,
      "name": entry.data.title,
      "description": `Verified statistics, global rankings, and statutory facts for ${entry.data.category} in India, sourced from ${entry.data.officialAuthority}.`,
      "url": pageUrl,
      "isBasedOn": entry.data.sourceUrl,
      "creator": {
        "@type": "Organization",
        "name": entry.data.officialAuthority,
        "url": entry.data.sourceUrl
      },
      "spatialCoverage": { "@type": "Place", "name": "Republic of India" },
      "temporalCoverage": "2025/2026"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{entry.data.title} | India Verified Facts Repository</title>
  <meta name="description" content={`Verified statistics and global rankings for ${entry.data.category} in India. Sourced from ${entry.data.officialAuthority}.`} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
  <style>
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 1.25rem;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-subtle);
      font-size: 0.92rem;
    }
    .meta-box {
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      padding: 0.85rem 1.1rem;
      border-radius: var(--radius-md);
    }
    .meta-box strong {
      display: block;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-muted);
      margin-bottom: 0.2rem;
    }
    .meta-box a {
      color: var(--chakra-blue);
      font-weight: 600;
      text-decoration: none;
    }
    .meta-box code {
      font-family: var(--font-mono);
      color: var(--green-accent);
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="container animate-fade-up">
    <a href={`${base || '/'}`} class="back-link">← Back to Master Repository Hub</a>
    
    <header class="hero-header">
      <span class="badge-saffron">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      <div class="meta-grid">
        <div class="meta-box">
          <strong>Primary Authority</strong>
          <span>{entry.data.officialAuthority}</span>
        </div>
        <div class="meta-box">
          <strong>Official Verification Portal</strong>
          <a href={entry.data.sourceUrl} target="_blank" rel="noopener">{entry.data.sourceUrl} ↗</a>
        </div>
        <div class="meta-box">
          <strong>Last Verified Baseline</strong>
          <code>{entry.data.lastUpdated.toISOString().split('T')[0]}</code>
        </div>
      </div>
    </header>

    <article>
      <Content/>
    </article>
  </div>

  <script>
    // 1. Wrap all Markdown tables in responsive modern card containers
    document.querySelectorAll('article table').forEach((table) => {
      if (!table.parentElement?.classList.contains('table-container')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-container';
        table.parentNode?.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });

    // 2. Automatically highlight rows representing India's Position or Rank
    document.querySelectorAll('article tbody tr').forEach((row) => {
      const text = row.textContent || '';
      if (
        text.includes("India's Position") ||
        text.includes("(India)") ||
        text.includes("Rank — India") ||
        text.includes("Indian Citizen") ||
        text.includes("Indian-Born") ||
        (text.includes("India") && (text.includes("#") || text.includes("Rank")))
      ) {
        row.classList.add('india-highlight-row');
      }
    });
  </script>
</body>
</html>
