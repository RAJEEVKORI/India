---
import { getCollection } from 'astro:content';
import '../styles/tiranga-theme.css';

const dataEntries = (await getCollection('data')).sort((a, b) => a.slug.localeCompare(b.slug));
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://rajeevkori.github.io';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "India Verified Facts, Global Rankings & Official Cartography Repository",
  "url": `${siteUrl}${base}/`,
  "description": "Government-backed repository of verified statistics, global rankings, and official Survey of India cartography.",
  "publisher": {
    "@type": "Organization",
    "name": "India Verified Facts & Cartography Repository",
    "url": `${siteUrl}${base}/`
  }
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>India Verified Facts, Global Rankings & Official Cartography Repository</title>
  <meta name="description" content="Official, primary-sourced repository of verified facts, government statistics, global rankings, and Survey of India compliant maps." />
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />
  <style>
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1.25rem;
      margin-top: 2rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--border-subtle);
    }
    .kpi-box {
      background: var(--bg-canvas);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
    }
    .kpi-val {
      font-family: var(--font-mono);
      font-size: 1.45rem;
      font-weight: 700;
      color: var(--chakra-blue);
      display: block;
    }
    .kpi-label {
      font-size: 0.83rem;
      color: var(--ink-muted);
      font-weight: 500;
    }
    .map-banner {
      background: linear-gradient(120deg, var(--saffron-faint) 0%, #FFFFFF 50%, var(--green-faint) 100%);
      border: 1px solid var(--chakra-border);
      border-radius: var(--radius-lg);
      padding: 2.25rem 2.5rem;
      margin-bottom: 2.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      box-shadow: var(--shadow-calm);
    }
    .btn-chakra {
      background: var(--chakra-blue);
      color: #FFFFFF;
      padding: 0.85rem 1.65rem;
      border-radius: var(--radius-pill);
      font-weight: 600;
      font-size: 0.95rem;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(6, 3, 141, 0.2);
      transition: transform 0.2s ease, background 0.2s ease;
      white-space: nowrap;
    }
    .btn-chakra:hover {
      background: var(--saffron-flag);
      transform: translateY(-2px);
    }
    .search-wrapper {
      margin-bottom: 2.5rem;
    }
    .search-box {
      width: 100%;
      padding: 1.1rem 1.5rem;
      border-radius: var(--radius-pill);
      border: 1px solid var(--chakra-border);
      background: var(--bg-card);
      color: var(--ink-primary);
      font-family: var(--font-sans);
      font-size: 1.02rem;
      box-shadow: var(--shadow-calm);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .search-box:focus {
      outline: none;
      border-color: var(--chakra-blue);
      box-shadow: 0 0 0 4px var(--chakra-faint);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.85rem;
      margin-bottom: 4rem;
    }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-top: 4px solid var(--chakra-blue);
      border-radius: var(--radius-lg);
      padding: 2rem;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-calm);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease;
    }
    .card:nth-child(3n+1) { border-top-color: var(--saffron-flag); }
    .card:nth-child(3n+2) { border-top-color: var(--chakra-blue); }
    .card:nth-child(3n+3) { border-top-color: var(--green-accent); }
    .card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-hover);
    }
    .card h3 {
      font-family: var(--font-display);
      font-size: 1.35rem;
      color: var(--ink-primary);
      margin: 0.4rem 0 0.85rem;
      line-height: 1.35;
    }
    .card-footer {
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
      font-size: 0.85rem;
      color: var(--ink-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    footer {
      text-align: center;
      border-top: 1px solid var(--border-subtle);
      padding-top: 2.5rem;
      color: var(--ink-muted);
      font-size: 0.92rem;
    }
    footer a {
      color: var(--chakra-blue);
      font-weight: 600;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="container animate-fade-up">
    <header class="hero-header">
      <!-- Subtle Ashoka Chakra 24-Spoke Watermark -->
      <svg class="chakra-watermark" viewBox="0 0 100 100" fill="none" stroke="#06038D" stroke-width="2">
        <circle cx="50" cy="50" r="44" stroke-width="3.5" />
        <circle cx="50" cy="50" r="8" fill="#06038D" />
        {Array.from({ length: 24 }).map((_, i) => {
          const angle = (i * 15 * Math.PI) / 180;
          const x2 = 50 + 44 * Math.cos(angle);
          const y2 = 50 + 44 * Math.sin(angle);
          return <line x1="50" y1="50" x2={x2} y2={y2} />;
        })}
      </svg>

      <span class="badge-tiranga">✓ Primary Government & Global Institutional Baseline</span>
      <h1>India Verified Facts, Rankings & Official Cartography</h1>
      <p style="font-size: 1.12rem; color: var(--ink-muted); max-width: 820px;">
        A standalone, primary-sourced encyclopedic reference comparing India's global rankings (Top 3, India's Position, and Bottom 3), statutory frameworks, scientific contributions, and Survey of India compliant maps.
      </p>

      <div class="kpi-grid">
        <div class="kpi-box">
          <span class="kpi-val">15,106.7 km</span>
          <span class="kpi-label">Sovereign Land Border (SoI)</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-val">49.0%</span>
          <span class="kpi-label">Global Real-Time Payments (UPI)</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-val">35.42M</span>
          <span class="kpi-label">Global Diaspora (#1 Worldwide)</span>
        </div>
        <div class="kpi-box">
          <span class="kpi-val">75.0%</span>
          <span class="kpi-label">World's Wild Tiger Population (#1)</span>
        </div>
      </div>
    </header>

    <section class="map-banner">
      <div>
        <span class="badge-saffron">Survey of India 1:4M Baseline</span>
        <h2 style="margin: 0.25rem 0 0.5rem; border: none; padding: 0;">Official Map of India — Creator & Media Download Hub</h2>
        <p style="color: var(--ink-body); max-width: 680px; font-size: 0.98rem;">
          Replace inaccurate or truncated maps with verified, distortion-free vector (<code>.SVG</code>), 4K raster (<code>.PNG</code>), and transparent overlay (<code>.WebP</code>) maps depicting all 28 States and 8 Union Territories.
        </p>
      </div>
      <a href={`${base}/maps/`} class="btn-chakra">Download Verified Maps →</a>
    </section>

    <div class="search-wrapper">
      <input type="search" id="categorySearch" class="search-box" placeholder="Search across 9 verified databases (e.g., CO2 Emissions, Coal, Remittances, Nobel Prizes, Defence, STEM, Tigers)..." />
    </div>

    <main class="grid" id="cardsGrid">
      {dataEntries.map((entry, idx) => (
        <a href={`${base}/data/${entry.slug}/`} class="card" style={`animation-delay: ${idx * 55}ms`} data-search={`${entry.data.title} ${entry.data.category} ${entry.data.officialAuthority}`.toLowerCase()}>
          <div>
            <span class="badge-saffron">{entry.data.category}</span>
            <h3>{entry.data.title}</h3>
          </div>
          <div class="card-footer">
            <span>{entry.data.officialAuthority}</span>
            <span style="color: var(--chakra-blue); font-weight: 700; font-family: var(--font-mono);">View Tables →</span>
          </div>
        </a>
      ))}
    </main>

    <footer>
      <p>
        Every statistic and cartographic file in this repository is directly verifiable via official Government of India portals (<a href="https://onlinemaps.surveyofindia.gov.in/" target="_blank" rel="noopener">Survey of India</a>, <a href="https://legislative.gov.in/" target="_blank" rel="noopener">Ministry of Law & Justice</a>, <a href="https://www.indiabudget.gov.in/" target="_blank" rel="noopener">Ministry of Finance</a>, <a href="https://mnre.gov.in/" target="_blank" rel="noopener">MNRE</a>, <a href="https://www.mea.gov.in/" target="_blank" rel="noopener">MEA</a>) and global institutional registries.
      </p>
    </footer>
  </div>

  <script>
    const searchInput = document.getElementById('categorySearch');
    const cards = document.querySelectorAll('#cardsGrid .card');
    searchInput?.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      cards.forEach((card) => {
        const text = card.getAttribute('data-search') || '';
        (card as HTMLElement).style.display = text.includes(q) ? 'flex' : 'none';
      });
    });
  </script>
</body>
</html>
